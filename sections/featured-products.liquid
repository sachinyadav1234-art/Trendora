<section class="trendora-products">
  <div class="trendora-products__header">
    <div>
      <p class="trendora-products__eyebrow">TRENDING NOW</p>
      <h2>Featured Products</h2>
    </div>

    <a href="/collections/all" class="trendora-products__link">
      View All →
    </a>
  </div>

  <div class="trendora-products__grid">
    {% assign featured_collection = collections.all %}

    {% for product in featured_collection.products limit: 4 %}
      <article class="trendora-product-card">

        <a href="{{ product.url }}" class="trendora-product-card__image">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 600 }}"
              alt="{{ product.featured_image.alt | escape }}"
              loading="lazy"
              width="600"
              height="600"
            >
          {% else %}
            {{ 'product-1' | placeholder_svg_tag }}
          {% endif %}
        </a>

        <div class="trendora-product-card__info">
          <h3>
            <a href="{{ product.url }}">
              {{ product.title }}
            </a>
          </h3>

          <p class="trendora-product-card__price">
            {{ product.price | money }}
          </p>
        </div>

      </article>
    {% endfor %}
  </div>
</section>

<style>
  .trendora-products {
    padding: 90px 7%;
    background: #ffffff;
  }

  .trendora-products__header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 45px;
  }

  .trendora-products__eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
  }

  .trendora-products h2 {
    margin: 0;
    font-size: 48px;
    letter-spacing: -2px;
  }

  .trendora-products__link {
    color: #111;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid #111;
    padding-bottom: 5px;
  }

  .trendora-products__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .trendora-product-card {
    min-width: 0;
  }

  .trendora-product-card__image {
    display: block;
    overflow: hidden;
    background: #f3f1ed;
    aspect-ratio: 1 / 1;
  }

  .trendora-product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .trendora-product-card:hover img {
    transform: scale(1.04);
  }

  .trendora-product-card__info {
    padding-top: 16px;
  }

  .trendora-product-card h3 {
    margin: 0 0 8px;
    font-size: 16px;
  }

  .trendora-product-card h3 a {
    color: #111;
    text-decoration: none;
  }

  .trendora-product-card__price {
    margin: 0;
    font-size: 15px;
  }

  @media (max-width: 900px) {
    .trendora-products__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .trendora-products {
      padding: 60px 20px;
    }

    .trendora-products__header {
      align-items: start;
      gap: 20px;
    }

    .trendora-products h2 {
      font-size: 36px;
    }

    .trendora-products__grid {
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Featured Products",
  "settings": []
}
{% endschema %}