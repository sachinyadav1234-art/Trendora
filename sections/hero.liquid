<section class="trendora-hero" style="background-color: {{ section.settings.bg_color | default: '#f5f2ed' }};">
  <div class="trendora-hero__inner page-width">
    
    <div class="trendora-hero__content">
      <p class="trendora-hero__eyebrow">
        {{ section.settings.eyebrow | default: "NEW SEASON 2026" }}
      </p>

      <h1>
        {{ section.settings.title | default: "Style That Speaks For You." }}
      </h1>

      <p class="trendora-hero__text">
        {{ section.settings.text | default: "Discover modern fashion designed for everyday confidence. Find your next favorite look at Trendora." }}
      </p>

      <div class="trendora-hero__actions">
        <a href="{{ section.settings.primary_button_link | default: routes.all_products_collection_url }}" class="trendora-btn trendora-btn--primary">
          {{ section.settings.primary_button_text | default: "Shop Now →" }}
        </a>

        {% if section.settings.secondary_button_text != blank %}
          <a href="{{ section.settings.secondary_button_link | default: routes.collections_url }}" class="trendora-btn trendora-btn--outline">
            {{ section.settings.secondary_button_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="trendora-hero__visual">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 1000 }}"
          alt="{{ section.settings.title | escape }}"
          loading="eager"
          width="1000"
          height="1200"
          class="trendora-hero__img"
        >
      {% else %}
        <div class="trendora-hero__card">
          <div class="trendora-hero__card-badge">2026 EDITION</div>
          <span>TRENDORA</span>
          <p class="trendora-hero__card-sub">ESSENTIAL FASHION</p>
        </div>
      {% endif %}
    </div>

  </div>
</section>

<style>
.trendora-hero {
  min-height: 620px;
  display: flex;
  align-items: center;
  padding: 60px 0;
}

.trendora-hero__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 60px;
  width: 100%;
}

.trendora-hero__content {
  max-width: 620px;
}

.trendora-hero__eyebrow {
  margin: 0 0 16px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 3.5px;
  text-transform: uppercase;
  color: #171717;
}

.trendora-hero h1 {
  margin: 0 0 24px;
  font-size: clamp(42px, 5.5vw, 76px);
  line-height: 1.02;
  letter-spacing: -2.5px;
  font-weight: 800;
  color: #171717;
}

.trendora-hero__text {
  margin-bottom: 35px;
  font-size: 18px;
  line-height: 1.6;
  color: #555555;
}

.trendora-hero__actions {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.trendora-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16px 36px;
  font-size: 15px;
  font-weight: 700;
  border-radius: 2px;
  transition: transform 0.2s ease, background-color 0.2s ease;
  cursor: pointer;
  text-decoration: none;
}

.trendora-btn--primary {
  background: #171717;
  color: #ffffff;
  border: 1px solid #171717;
}

.trendora-btn--primary:hover {
  background: #333333;
  transform: translateY(-2px);
}

.trendora-btn--outline {
  background: transparent;
  color: #171717;
  border: 1px solid #171717;
}

.trendora-btn--outline:hover {
  background: #171717;
  color: #ffffff;
  transform: translateY(-2px);
}

.trendora-hero__visual {
  min-height: 420px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trendora-hero__img {
  width: 100%;
  max-width: 480px;
  height: auto;
  border-radius: 4px;
  box-shadow: 0 20px 40px rgba(0,0,0,0.08);
  object-fit: cover;
}

.trendora-hero__card {
  width: min(380px, 90%);
  aspect-ratio: 3 / 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e4ded5 0%, #cdc3b5 100%);
  color: #171717;
  font-size: 34px;
  font-weight: 800;
  letter-spacing: 6px;
  box-shadow: 0 20px 40px rgba(0,0,0,0.08);
  border-radius: 4px;
  position: relative;
  transition: transform 0.4s ease;
}

.trendora-hero__card:hover {
  transform: translateY(-4px) rotate(1deg);
}

.trendora-hero__card-badge {
  position: absolute;
  top: 24px;
  font-size: 11px;
  letter-spacing: 2px;
  font-weight: 700;
  background: #171717;
  color: #fff;
  padding: 6px 14px;
}

.trendora-hero__card-sub {
  margin-top: 12px;
  font-size: 12px;
  letter-spacing: 3px;
  font-weight: 600;
  color: #555555;
}

@media (max-width: 900px) {
  .trendora-hero {
    padding: 50px 0;
  }

  .trendora-hero__inner {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .trendora-hero h1 {
    font-size: 46px;
  }

  .trendora-hero__visual {
    min-height: 320px;
  }
}

@media (max-width: 400px) {
  .trendora-hero h1 {
    font-size: 36px;
  }

  .trendora-btn {
    width: 100%;
  }
}
</style>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "NEW SEASON 2026"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Heading",
      "default": "Style That Speaks For You."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subheadline Text",
      "default": "Discover modern fashion designed for everyday confidence. Find your next favorite look at Trendora."
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary Button Text",
      "default": "Shop Now →"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary Button Text",
      "default": "Explore Categories"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f2ed"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
