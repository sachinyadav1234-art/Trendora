<section class="trendora-search">
  <div class="trendora-search__header">
    <p class="trendora-search__eyebrow">DISCOVER</p>
    <h1>Search Trendora</h1>
    <p>Find your favorite products and explore the latest collection.</p>

    <form action="{{ routes.search_url }}" method="get" class="trendora-search__form">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search products..."
        aria-label="Search products"
      >
      <input type="hidden" name="type" value="product">
      <button type="submit">Search →</button>
    </form>
  </div>

  {% if search.performed %}
    <div class="trendora-search__results">

      {% if search.results_count > 0 %}

        <div class="trendora-search__top">
          <h2>Search Results</h2>
          <span>{{ search.results_count }} results</span>
        </div>

        <div class="trendora-search__grid">

          {% paginate search.results by 12 %}

            {% for result in search.results %}

              <a href="{{ result.url }}" class="trendora-search-card">

                <div class="trendora-search-card__image">

                  {% if result.featured_image %}
                    <img
                      src="{{ result.featured_image | image_url: width: 700 }}"
                      alt="{{ result.featured_image.alt | default: result.title | escape }}"
                      loading="lazy"
                    >
                  {% else %}
                    <div class="trendora-search-card__placeholder">
                      Trendora
                    </div>
                  {% endif %}

                </div>

                <div class="trendora-search-card__info">

                  <p class="trendora-search-card__type">
                    {{ result.object_type | capitalize }}
                  </p>

                  <h3>{{ result.title }}</h3>

                  {% if result.object_type == 'product' %}
                    <p class="trendora-search-card__price">
                      {{ result.price | money }}
                    </p>
                  {% endif %}

                  <span class="trendora-search-card__link">
                    View Product →
                  </span>

                </div>

              </a>

            {% endfor %}

            {% if paginate.pages > 1 %}
              <div class="trendora-pagination">
                {{ paginate | default_pagination }}
              </div>
            {% endif %}

          {% endpaginate %}

        </div>

      {% else %}

        <div class="trendora-search-empty">
          <p class="trendora-search__eyebrow">NO RESULTS</p>
          <h2>We couldn't find anything.</h2>
          <p>Try searching for another product or collection.</p>

          <a href="{{ routes.root_url }}">
            Continue Shopping →
          </a>
        </div>

      {% endif %}

    </div>

  {% endif %}
</section>


<style>
.trendora-search {
  max-width: 1400px;
  margin: 0 auto;
  padding: 100px 7%;
}

.trendora-search__header {
  max-width: 900px;
  margin-bottom: 80px;
}

.trendora-search__eyebrow {
  margin: 0 0 18px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 5px;
}

.trendora-search h1 {
  margin: 0;
  font-size: clamp(48px, 7vw, 90px);
  line-height: 0.95;
  letter-spacing: -4px;
}

.trendora-search__header > p:not(.trendora-search__eyebrow) {
  margin: 28px 0 40px;
  font-size: 18px;
  line-height: 1.6;
  color: #555;
}

.trendora-search__form {
  display: flex;
  max-width: 750px;
}

.trendora-search__form input[type="search"] {
  flex: 1;
  min-width: 0;
  padding: 18px 20px;
  border: 1px solid #222;
  border-right: none;
  font-size: 16px;
  outline: none;
}

.trendora-search__form button {
  padding: 18px 32px;
  border: 1px solid #222;
  background: #171717;
  color: white;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
}

.trendora-search__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #ddd;
  padding-bottom: 22px;
  margin-bottom: 35px;
}

.trendora-search__top h2 {
  margin: 0;
  font-size: 32px;
}

.trendora-search__top span {
  color: #666;
}

.trendora-search__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 35px 25px;
}

.trendora-search-card {
  color: inherit;
  text-decoration: none;
}

.trendora-search-card__image {
  aspect-ratio: 1 / 1;
  background: #f3f1ed;
  overflow: hidden;
}

.trendora-search-card__image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  transition: transform 0.4s ease;
}

.trendora-search-card:hover img {
  transform: scale(1.05);
}

.trendora-search-card__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 700;
}

.trendora-search-card__info {
  padding-top: 18px;
}

.trendora-search-card__type {
  margin: 0 0 8px;
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #777;
}

.trendora-search-card h3 {
  margin: 0;
  font-size: 18px;
  line-height: 1.3;
}

.trendora-search-card__price {
  margin: 10px 0;
  font-size: 16px;
  font-weight: 600;
}

.trendora-search-card__link {
  display: inline-block;
  margin-top: 5px;
  font-size: 14px;
  text-decoration: underline;
}

.trendora-search-empty {
  text-align: center;
  padding: 80px 20px;
  background: #f5f3ef;
}

.trendora-search-empty h2 {
  margin: 0 0 15px;
  font-size: 42px;
}

.trendora-search-empty p:not(.trendora-search__eyebrow) {
  color: #666;
}

.trendora-search-empty a {
  display: inline-block;
  margin-top: 20px;
  color: #111;
  font-weight: 600;
}

.trendora-pagination {
  grid-column: 1 / -1;
  text-align: center;
  padding-top: 40px;
}

.trendora-pagination a,
.trendora-pagination span {
  display: inline-block;
  margin: 0 6px;
  padding: 8px 12px;
}

@media (max-width: 900px) {
  .trendora-search {
    padding: 70px 5%;
  }

  .trendora-search__grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .trendora-search h1 {
    letter-spacing: -2px;
  }
}

@media (max-width: 600px) {
  .trendora-search {
    padding: 50px 20px;
  }

  .trendora-search__form {
    flex-direction: column;
  }

  .trendora-search__form input[type="search"] {
    border-right: 1px solid #222;
  }

  .trendora-search__form button {
    width: 100%;
  }

  .trendora-search__grid {
    grid-template-columns: 1fr;
  }

  .trendora-search__top {
    align-items: flex-start;
    gap: 10px;
    flex-direction: column;
  }

  .trendora-search-empty h2 {
    font-size: 32px;
  }
}
</style>