<section class="trendora-categories page-width">
  <div class="trendora-categories__header">
    <div>
      <p class="trendora-eyebrow">
        {{ section.settings.eyebrow | default: "EXPLORE" }}
      </p>
      <h2>
        {{ section.settings.heading | default: "Shop by Category" }}
      </h2>
    </div>

    <p class="trendora-categories__text">
      {{ section.settings.subheading | default: "Find your style and discover your next favorite look." }}
    </p>
  </div>

  <div class="trendora-categories__grid">
    {% assign count = 0 %}
    {% for collection in collections limit: 8 %}
      {% unless collection.handle == 'all' %}
        {% assign count = count | plus: 1 %}
        {% if count <= 4 %}
          <a href="{{ collection.url }}" class="trendora-category-card">
            <div class="trendora-category-image">
              {% if collection.image %}
                <img
                  src="{{ collection.image | image_url: width: 800 }}"
                  alt="{{ collection.image.alt | default: collection.title | escape }}"
                  loading="lazy"
                  width="800"
                  height="1000"
                >
              {% elsif collection.products.first.featured_image %}
                <img
                  src="{{ collection.products.first.featured_image | image_url: width: 800 }}"
                  alt="{{ collection.title | escape }}"
                  loading="lazy"
                  width="800"
                  height="1000"
                >
              {% else %}
                <div class="trendora-category-placeholder">
                  {{ collection.title | slice: 0, 1 }}
                </div>
              {% endif %}
            </div>

            <div class="trendora-category-info">
              <h3>{{ collection.title }}</h3>
              <span>Shop Now →</span>
            </div>
          </a>
        {% endif %}
      {% endunless %}
    {% endfor %}

    {% if count == 0 %}
      {% comment %} Onboarding fallback cards when store has no collections created yet {% endcomment %}
      {% assign default_categories = "Women's Collection,Men's Apparel,Accessories,New Arrivals" | split: "," %}
      {% for category in default_categories %}
        <a href="{{ routes.all_products_collection_url }}" class="trendora-category-card">
          <div class="trendora-category-image">
            <div class="trendora-category-placeholder">
              {{ category | slice: 0, 1 }}
            </div>
          </div>
          <div class="trendora-category-info">
            <h3>{{ category }}</h3>
            <span>Shop Now →</span>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</section>

<style>
.trendora-categories {
  padding: 80px 0;
  background: #ffffff;
}

.trendora-categories__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 40px;
  margin-bottom: 45px;
}

.trendora-eyebrow {
  margin: 0 0 12px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 3.5px;
  text-transform: uppercase;
  color: #171717;
}

.trendora-categories h2 {
  margin: 0;
  font-size: clamp(32px, 4vw, 48px);
  letter-spacing: -1.5px;
  font-weight: 800;
  color: #171717;
}

.trendora-categories__text {
  max-width: 380px;
  margin: 0;
  font-size: 16px;
  line-height: 1.6;
  color: #555555;
}

.trendora-categories__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.trendora-category-card {
  display: block;
  color: inherit;
  text-decoration: none;
}

.trendora-category-image {
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: #f2f0ec;
  border-radius: 2px;
}

.trendora-category-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}

.trendora-category-card:hover img {
  transform: scale(1.06);
}

.trendora-category-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64px;
  font-weight: 800;
  color: #a0988e;
  background: #e9e4dc;
}

.trendora-category-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 0;
  gap: 10px;
}

.trendora-category-info h3 {
  margin: 0;
  font-size: 18px;
  font-weight: 700;
}

.trendora-category-info span {
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
  color: #171717;
}

@media (max-width: 900px) {
  .trendora-categories__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .trendora-categories {
    padding: 50px 0;
  }

  .trendora-categories__header {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .trendora-categories__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
}

@media (max-width: 400px) {
  .trendora-categories__grid {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "EXPLORE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Shop by Category"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find your style and discover your next favorite look."
    }
  ],
  "presets": [
    {
      "name": "Shop by Category"
    }
  ]
}
{% endschema %}