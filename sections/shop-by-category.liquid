<section class="trendora-categories">
  <div class="trendora-categories__header">
    <div>
      <p class="trendora-eyebrow">EXPLORE</p>
      <h2>Shop by Category</h2>
    </div>

    <p class="trendora-categories__text">
      Find your style and discover your next favorite look.
    </p>
  </div>

  <div class="trendora-categories__grid">

    {% for collection in collections limit: 4 %}
      {% unless collection.handle == 'all' %}

        <a href="{{ collection.url }}" class="trendora-category-card">

          <div class="trendora-category-image">
            {% if collection.image %}
              <img
                src="{{ collection.image | image_url: width: 800 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
              >
            {% elsif collection.products.first.featured_image %}
              <img
                src="{{ collection.products.first.featured_image | image_url: width: 800 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
              >
            {% else %}
              <div class="trendora-category-placeholder">
                {{ collection.title | slice: 0, 1 }}
              </div>
            {% endif %}
          </div>

          <div class="trendora-category-info">
            <h3>{{ collection.title }}</h3>
            <span>Shop Now →</span>
          </div>

        </a>

      {% endunless %}
    {% endfor %}

  </div>
</section>


<style>
  .trendora-categories {
    padding: 90px 7%;
    background: #ffffff;
  }

  .trendora-categories__header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 40px;
    margin-bottom: 45px;
  }

  .trendora-eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 4px;
  }

  .trendora-categories h2 {
    margin: 0;
    font-size: 48px;
    line-height: 1;
    color: #222;
  }

  .trendora-categories__text {
    max-width: 360px;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: #555;
  }

  .trendora-categories__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .trendora-category-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .trendora-category-image {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f2f0ec;
  }

  .trendora-category-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .trendora-category-card:hover img {
    transform: scale(1.04);
  }

  .trendora-category-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 70px;
    font-weight: 700;
  }

  .trendora-category-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 2px;
    gap: 10px;
  }

  .trendora-category-info h3 {
    margin: 0;
    font-size: 20px;
  }

  .trendora-category-info span {
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .trendora-categories__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .trendora-categories {
      padding: 60px 5%;
    }

    .trendora-categories__header {
      display: block;
    }

    .trendora-categories h2 {
      font-size: 36px;
    }

    .trendora-categories__text {
      margin-top: 18px;
    }

    .trendora-categories__grid {
      grid-template-columns: 1fr;
    }
  }
</style>


{% schema %}
{
  "name": "Shop by Category",
  "settings": []
}
{% endschema %}