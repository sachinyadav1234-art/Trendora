<section class="trendora-collection page-width">

  <!-- Collection Header -->
  <div class="trendora-collection__header">
    <div>
      <p class="trendora-eyebrow">TRENDORA COLLECTION</p>
      <h1>
        {{ collection.title | default: "All Products" }}
      </h1>
    </div>

    {% if collection.description != blank %}
      <div class="trendora-collection__description">
        {{ collection.description }}
      </div>
    {% endif %}
  </div>

  <!-- Toolbar -->
  <div class="trendora-collection__toolbar">
    <p class="trendora-collection__count">
      Showing {{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}
    </p>

    <form method="get" action="{{ collection.url }}" class="trendora-sort-form">
      <label for="SortBy">Sort by:</label>
      {% assign current_sort = collection.sort_by | default: collection.default_sort_by %}
      <select name="sort_by" id="SortBy" onchange="this.form.submit()" aria-label="Sort products">
        <option value="manual" {% if current_sort == 'manual' %}selected{% endif %}>Featured</option>
        <option value="best-selling" {% if current_sort == 'best-selling' %}selected{% endif %}>Best Selling</option>
        <option value="title-ascending" {% if current_sort == 'title-ascending' %}selected{% endif %}>Alphabetically, A-Z</option>
        <option value="title-descending" {% if current_sort == 'title-descending' %}selected{% endif %}>Alphabetically, Z-A</option>
        <option value="price-ascending" {% if current_sort == 'price-ascending' %}selected{% endif %}>Price, Low to High</option>
        <option value="price-descending" {% if current_sort == 'price-descending' %}selected{% endif %}>Price, High to Low</option>
        <option value="created-descending" {% if current_sort == 'created-descending' %}selected{% endif %}>Date, New to Old</option>
      </select>
    </form>
  </div>

  <!-- Products Grid -->
  {% assign limit = section.settings.products_per_page | default: 12 %}
  {% paginate collection.products by limit %}

    {% if collection.products.size > 0 %}

      <div class="trendora-collection__grid">
        {% for product in collection.products %}
          <article class="trendora-collection-card">
            <a href="{{ product.url }}" class="trendora-collection-card__image">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="800"
                  height="1000"
                >
              {% else %}
                <div class="trendora-placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}

              <!-- Badges -->
              {% if product.available == false %}
                <span class="trendora-badge trendora-badge--sold">Sold Out</span>
              {% elsif product.compare_at_price > product.price %}
                <span class="trendora-badge trendora-badge--sale">Sale</span>
              {% endif %}
            </a>

            <div class="trendora-collection-card__info">
              <h2>
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h2>

              <div class="trendora-collection-card__bottom">
                <div class="trendora-price-wrap">
                  <span class="trendora-price">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="trendora-compare-price">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                </div>

                {% if product.available %}
                  <span class="trendora-stock">In Stock</span>
                {% else %}
                  <span class="trendora-sold">Sold Out</span>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>

      <!-- Pagination -->
      {% if paginate.pages > 1 %}
        <nav class="trendora-pagination" aria-label="Collection Pagination">
          {{ paginate | default_pagination }}
        </nav>
      {% endif %}

    {% else %}

      <!-- Empty Collection -->
      <div class="trendora-empty">
        <p class="trendora-eyebrow">COLLECTION EMPTY</p>
        <h2>No products found</h2>
        <p>There are currently no products available in this collection.</p>
        <a href="{{ routes.all_products_collection_url }}" class="trendora-btn trendora-btn--primary">
          Explore All Products →
        </a>
      </div>

    {% endif %}

  {% endpaginate %}

</section>

<style>
.trendora-collection {
  padding: 60px 0 100px;
}

.trendora-collection__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 40px;
  margin-bottom: 50px;
}

.trendora-eyebrow {
  margin: 0 0 12px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 3.5px;
  text-transform: uppercase;
  color: var(--text-color, #171717);
}

.trendora-collection h1 {
  margin: 0;
  font-size: clamp(36px, 5vw, 64px);
  line-height: 1.05;
  letter-spacing: -2px;
  font-weight: 800;
  color: var(--text-color, #171717);
}

.trendora-collection__description {
  max-width: 450px;
  color: var(--text-muted, #555555);
  line-height: 1.6;
  font-size: 16px;
}

.trendora-collection__toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--border-color, #e0e0e0);
  border-bottom: 1px solid var(--border-color, #e0e0e0);
  padding: 16px 0;
  margin-bottom: 40px;
}

.trendora-collection__count {
  margin: 0;
  color: var(--text-muted, #555555);
  font-size: 14px;
  font-weight: 600;
}

.trendora-sort-form {
  display: flex;
  align-items: center;
  gap: 10px;
}

.trendora-sort-form label {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-color, #171717);
}

.trendora-sort-form select {
  padding: 8px 14px;
  border: 1px solid var(--border-color, #171717);
  background: var(--input-bg, #ffffff);
  color: var(--input-text, #171717);
  font-size: 14px;
  border-radius: 2px;
  outline: none;
}

.trendora-collection__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px 28px;
}

.trendora-collection-card {
  color: inherit;
  text-decoration: none;
}

.trendora-collection-card__image {
  position: relative;
  display: block;
  aspect-ratio: 3 / 4;
  background: var(--surface-bg, #f3f1ed);
  overflow: hidden;
  border-radius: 2px;
}

.trendora-collection-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}

.trendora-collection-card:hover .trendora-collection-card__image img {
  transform: scale(1.05);
}

.trendora-badge {
  position: absolute;
  top: 14px;
  left: 14px;
  padding: 6px 12px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.trendora-badge--sale {
  background: var(--badge-bg, #171717);
  color: var(--badge-text, #ffffff);
}

.trendora-badge--sold {
  background: var(--bg-color, #ffffff);
  color: var(--text-color, #171717);
  border: 1px solid var(--border-color, #171717);
}

.trendora-collection-card__info {
  padding-top: 16px;
}

.trendora-collection-card__info h2 {
  margin: 0 0 10px;
  font-size: 18px;
  font-weight: 700;
}

.trendora-collection-card__info h2 a {
  color: var(--text-color, #171717);
  text-decoration: none;
}

.trendora-collection-card__bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.trendora-price-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
}

.trendora-price {
  font-size: 16px;
  font-weight: 700;
  color: var(--text-color, #171717);
}

.trendora-compare-price {
  font-size: 14px;
  color: var(--text-muted, #888888);
  text-decoration: line-through;
}

.trendora-stock {
  color: #287a43;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.trendora-sold {
  color: var(--text-muted, #888888);
  font-size: 12px;
  font-weight: 600;
}

.trendora-pagination {
  margin-top: 60px;
  text-align: center;
}

.trendora-pagination a,
.trendora-pagination span {
  display: inline-block;
  margin: 0 4px;
  padding: 10px 16px;
  color: var(--text-color, #171717);
  border: 1px solid var(--border-color, #e0e0e0);
  font-weight: 600;
  text-decoration: none;
}

.trendora-pagination .current {
  background: var(--btn-primary-bg, #171717);
  color: var(--btn-primary-text, #ffffff);
  border-color: var(--btn-primary-bg, #171717);
}

.trendora-empty {
  padding: 80px 20px;
  text-align: center;
  background: var(--surface-bg, #f5f3ef);
  color: var(--text-color, #171717);
  border-radius: 4px;
}

.trendora-empty h2 {
  margin: 0 0 15px;
  font-size: 36px;
}

@media (max-width: 900px) {
  .trendora-collection__header {
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .trendora-collection__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
}

@media (max-width: 600px) {
  .trendora-collection {
    padding: 40px 0 60px;
  }

  .trendora-collection__toolbar {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .trendora-sort-form {
    width: 100%;
    justify-content: space-between;
  }

  .trendora-collection__grid {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "Collection Product Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 24,
      "step": 6,
      "default": 12,
      "label": "Products per page"
    }
  ]
}
{% endschema %}