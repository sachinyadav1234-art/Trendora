{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family | default: 'sans-serif' }}, {{ settings.type_primary_font.fallback_families | default: 'sans-serif' }};
    --font-primary--style: {{ settings.type_primary_font.style | default: 'normal' }};
    --font-primary--weight: {{ settings.type_primary_font.weight | default: '400' }};
    --page-width: {{ settings.max_page_width | default: '1400px' }};
    --page-margin: {{ settings.min_page_margin | default: '20' }}px;
    --color-background: {{ settings.background_color | default: '#ffffff' }};
    --color-foreground: {{ settings.foreground_color | default: '#171717' }};
    --bg-color: #ffffff;
    --text-color: #171717;
    --text-muted: #555555;
    --surface-bg: #f9f9f9;
    --card-bg: #ffffff;
    --border-color: #e5e5e5;
    --input-bg: #ffffff;
    --input-text: #171717;
    --btn-primary-bg: #171717;
    --btn-primary-text: #ffffff;
    --btn-outline-border: #171717;
    --btn-outline-text: #171717;
    --badge-bg: #171717;
    --badge-text: #ffffff;
  }

  html.dark-theme {
    --color-background: #121212;
    --color-foreground: #f5f5f5;
    --bg-color: #121212;
    --text-color: #f5f5f5;
    --text-muted: #aaaaaa;
    --surface-bg: #1e1e1e;
    --card-bg: #1e1e1e;
    --border-color: #333333;
    --input-bg: #2a2a2a;
    --input-text: #ffffff;
    --btn-primary-bg: #ffffff;
    --btn-primary-text: #121212;
    --btn-outline-border: #ffffff;
    --btn-outline-text: #ffffff;
    --badge-bg: #ffffff;
    --badge-text: #121212;
  }

  body {
    background-color: var(--bg-color);
    color: var(--text-color);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  /* Global dark-theme overrides for high visibility */
  html.dark-theme h1,
  html.dark-theme h2,
  html.dark-theme h3,
  html.dark-theme h4,
  html.dark-theme h5,
  html.dark-theme h6 {
    color: var(--text-color);
  }

  html.dark-theme input,
  html.dark-theme select,
  html.dark-theme textarea {
    background-color: var(--input-bg);
    color: var(--input-text);
    border-color: var(--border-color);
  }
{% endstyle %}
