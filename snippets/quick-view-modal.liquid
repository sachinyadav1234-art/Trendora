{% comment %}
  Quick View Modal Snippet
  Usage: {% render 'quick-view-modal' %}
{% endcomment %}

<div class="trendora-modal-overlay" id="trendoraQuickViewOverlay" onclick="trendoraCloseQuickView()"></div>

<div class="trendora-quickview-modal" id="trendoraQuickViewModal" aria-hidden="true" role="dialog">
  <button type="button" class="trendora-quickview-close" onclick="trendoraCloseQuickView()" aria-label="Close modal">✕</button>
  <div class="trendora-quickview-content" id="trendoraQuickViewContent">
    <div class="trendora-quickview-loading">
      <span>Loading Product Details...</span>
    </div>
  </div>
</div>

<style>
.trendora-quickview-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -45%);
  width: 90%;
  max-width: 850px;
  max-height: 90vh;
  background: var(--bg-color, #ffffff);
  color: var(--text-color, #171717);
  border-radius: 8px;
  z-index: 9999;
  opacity: 0;
  visibility: hidden;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
  transition: all 0.3s ease;
  overflow-y: auto;
  padding: 24px;
}

.trendora-quickview-modal.active {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, -50%);
}

.trendora-quickview-close {
  position: absolute;
  top: 16px;
  right: 16px;
  background: var(--surface-bg, #eee);
  border: none;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  font-size: 16px;
  cursor: pointer;
  z-index: 10;
}

.trendora-quickview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px;
  align-items: start;
}

@media (max-width: 700px) {
  .trendora-quickview-grid {
    grid-template-columns: 1fr;
  }
}

.trendora-quickview-media img {
  width: 100%;
  border-radius: 6px;
  object-fit: cover;
}

.trendora-quickview-details h2 {
  font-size: 22px;
  font-weight: 700;
  margin: 0 0 10px 0;
}

.trendora-quickview-price {
  font-size: 18px;
  font-weight: 700;
  margin-bottom: 16px;
}

.trendora-quickview-desc {
  font-size: 13px;
  line-height: 1.5;
  color: #666;
  margin-bottom: 20px;
}
</style>

<script>
function trendoraOpenQuickView(productUrl) {
  const modal = document.getElementById('trendoraQuickViewModal');
  const overlay = document.getElementById('trendoraQuickViewOverlay');
  const content = document.getElementById('trendoraQuickViewContent');

  modal.classList.add('active');
  overlay.classList.add('active');
  content.innerHTML = '<div class="trendora-quickview-loading">Loading Product...</div>';

  fetch(productUrl + '?view=quickview')
    .then(res => res.text())
    .then(html => {
      content.innerHTML = html;
    })
    .catch(() => {
      content.innerHTML = '<p>Could not load product details.</p>';
    });
}

function trendoraCloseQuickView() {
  document.getElementById('trendoraQuickViewModal').classList.remove('active');
  document.getElementById('trendoraQuickViewOverlay').classList.remove('active');
}
</script>
