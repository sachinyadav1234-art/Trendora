<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # SEO Meta tags & JSON-LD Structured Data %}
    {% render 'meta-tags' %}
    {% render 'seo-structured-data' %}

    {{ content_for_header }}
    {{ 'critical.css' | asset_url | stylesheet_tag }}

    {% # Load Trendora Core & Wishlist Scripts %}
    <script src="{{ 'trendora-core.js' | asset_url }}" defer></script>
    <script src="{{ 'wishlist.js' | asset_url }}" defer></script>
  </head>

  <body>
    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <!-- Global Cart Drawer & Quick View Modals -->
    {% render 'cart-drawer' %}
    {% render 'quick-view-modal' %}

    <!-- Back to Top Button -->
    <button type="button" class="trendora-back-to-top" id="trendoraBackToTop" onclick="trendoraScrollToTop()" aria-label="Scroll to top">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <style>
    .trendora-back-to-top {
      position: fixed;
      bottom: 30px;
      right: 30px;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--text-color, #171717);
      color: var(--bg-color, #ffffff);
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
      opacity: 0;
      visibility: hidden;
      transform: translateY(10px);
      transition: all 0.3s ease;
      z-index: 990;
    }

    .trendora-back-to-top.visible {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .trendora-back-to-top:hover {
      transform: translateY(-3px);
    }
    </style>
  </body>
</html>
